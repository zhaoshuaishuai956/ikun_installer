<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- M9: 纯逻辑测试, 不引用 WinForms 主工程, 可在 CI 容器 (linux) 运行 -->
    <AssemblyName>ikun_installer_tests</AssemblyName>
    <!-- CA1416: AppConfig 的注册表访问在非 Windows 运行时会回退环境变量, 属预期 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Versioning.cs" Link="src\Versioning.cs" />
    <Compile Include="..\DeploymentLayout.cs" Link="src\DeploymentLayout.cs" />
    <Compile Include="..\UpdateCheckInstanceGuard.cs" Link="src\UpdateCheckInstanceGuard.cs" />
  </ItemGroup>
</Project>
