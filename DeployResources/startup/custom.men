! 爱坤工具箱 (ikun tools) Menu

VERSION 121

EDIT UG_GATEWAY_MAIN_MENUBAR

AFTER UG_HELP
  CASCADE_BUTTON IKUN_TOOLS_NAME
  LABEL 爱坤工具箱
END_OF_AFTER

MENU IKUN_TOOLS_NAME
  BUTTON IKUN_EJECTOR
  LABEL 顶针布局
  BITMAP ikun_ejector_layout.bmp
  ACTIONS ejector_layout.dll

  SEPARATOR

  BUTTON IKUN_PMI
  LABEL 孔位标注
  BITMAP ikun_pmi_hole_dim.bmp
  ACTIONS pmi_hole_dim.dll
  SEPARATOR

  BUTTON IKUN_BLOCKBOSS
  LABEL 定位凸台
  BITMAP ikun_block_boss_layout.bmp
  ACTIONS block_boss_layout.dll
  SEPARATOR

  BUTTON IKUN_NESTER
  LABEL 实体排样
  BITMAP ikun_MultiEntityNester.bmp
  ACTIONS MultiEntityNester.dll
  SEPARATOR

  BUTTON IKUN_SLTEXT
  LABEL 单线刻字
  BITMAP ikun_single_line_text.bmp
  ACTIONS single_line_text.dll
  SEPARATOR

  BUTTON IKUN_TEXTLAYOUT
  LABEL 文字排版
  BITMAP ikun_text_auto_layout.bmp
  ACTIONS text_auto_layout.dll
  SEPARATOR

  BUTTON IKUN_TYPELAYOUT
  LABEL 活字排版
  BITMAP ikun_type_layout.bmp
  ACTIONS type_layout.dll
  SEPARATOR

  BUTTON IKUN_PLATEDWG
  LABEL 板面导出
  BITMAP ikun_plate_dwg_export.bmp
  ACTIONS plate_dwg_export.dll


  BUTTON IKUN_UPDATE
  LABEL 检查更新
  BITMAP ikun_tools.bmp
  ACTIONS ikun_updater.dll

END_OF_MENU