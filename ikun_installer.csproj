<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>爱坤工具箱 NX 安装器</AssemblyTitle>
    <ApplicationIcon>ikun-tools.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ikun_installer</AssemblyName>
    <!-- 测试增量更新基线：高于现有 2.1.0.* 安装器，便于验证版本检测与资源更新 -->
    <Version>2.1.1</Version>
    <!-- 自包含发布 + 只保留中文语言资源 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 允许在非 Windows 主机(GitHub Actions 的 Linux runner)上交叉发布 win-x64 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 嵌入所有部署资源 + NX 更新插件(由本机 nxplugin/build.ps1 编译)。
       application/ 只保留 .gitkeep 占位, 真实资源由 CI assemble 或 dev-assemble.ps1 生成 (规范 M5);
       .gitkeep 不嵌入 (红队批2 P2-6: 防安装时释放垃圾空文件) -->
  <ItemGroup>
    <EmbeddedResource Include="DeployResources\startup\**\*" />
    <EmbeddedResource Include="DeployResources\application\**\*" Exclude="DeployResources\application\.gitkeep" />
    <EmbeddedResource Include="nxplugin\ikun_updater.dll" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="services\**\*.cs" />
  </ItemGroup>

</Project>
