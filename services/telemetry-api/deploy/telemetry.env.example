# Copy to a protected server-side file; do not commit the filled file.
# base64(IKUN_TELEMETRY_ENCRYPTION_KEY) must decode to exactly 32 bytes.
# base64(IKUN_TELEMETRY_HMAC_KEY) must decode to at least 32 bytes.
IKUN_TELEMETRY_DB=postgresql://runtime_user:REDACTED@127.0.0.1:5432/telemetry
IKUN_TELEMETRY_ENCRYPTION_KEY=REDACTED_BASE64_32_BYTES
IKUN_TELEMETRY_HMAC_KEY=REDACTED_BASE64_32_BYTES

# The placeholder file contains no usable credentials.
# Required file mode in production: 0640, owner root, group service account.
# Never pass these values as command-line arguments.
